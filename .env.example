# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://endurance:endurance@localhost:5432/endurance_coach

# API
API_HOST=127.0.0.1
API_PORT=8000

# MCP
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8080
# Stateless Streamable HTTP (default): each request is self-contained.
# Required for Perplexity — discovers tools then invokes without a sticky session.
MCP_STATELESS_HTTP=true
# application/json-only Accept (common for connector tool calls) requires this.
MCP_JSON_RESPONSE=true
# Static Bearer only — do not advertise a fake OAuth authorization server.
MCP_ADVERTISE_OAUTH_RESOURCE=false
# Optional idle reap for stateful sessions (seconds). Only used if STATELESS=false.
# MCP_SESSION_IDLE_TIMEOUT_SECONDS=

# Bearer token for /api/v1/* and /mcp (installer runs scripts/generate_api_secret.ps1)
API_SECRET_KEY=

# Garmin — run scripts/garmin_auth.py after install; never store email/password here
GARMIN_TOKEN_PATH=~/.garminconnect
GARMIN_MCP_ENABLED=true
GARMIN_SYNC_DAYS=30
# Phone alert when Garmin rejects the saved login. Install the ntfy app and
# subscribe to this topic. The alert opens a sign-in page on PUBLIC_BASE_URL.
# Leave empty to disable.
GARMIN_ALERT_NTFY_TOPIC=
# Optional ntfy access token (tk_...). When set, the alert is also emailed
# to the verified address on that ntfy account. Never commit the real value.
GARMIN_ALERT_NTFY_TOKEN=

# Strava OAuth2 — create app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_TOKEN_PATH=~/.endurance-coach/strava_tokens.json
STRAVA_SYNC_DAYS=30

# Samsung Health — Android companion uploads batches to /api/v1/sync/samsung/import
SAMSUNG_HEALTH_IMPORT_DIR=~/.endurance-coach/samsung_health_import
SAMSUNG_HEALTH_SYNC_DAYS=365

# Public URL (https://your-host.example.com or http://127.0.0.1:8000 for local-only)
PUBLIC_BASE_URL=
DEFAULT_USER_EMAIL=
APP_TIMEZONE=America/Denver

# Coach LLM (optional — deterministic briefings work without keys)
COACH_LLM_PROVIDER=openai
COACH_LLM_MODEL=gpt-4o-mini
COACH_LLM_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional reverse proxy (set by installer if Caddy is enabled)
CADDY_ROOT=
CADDYFILE_PATH=
