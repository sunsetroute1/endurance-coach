# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://endurance:endurance@localhost:5432/endurance_coach

# API
API_HOST=127.0.0.1
API_PORT=8000

# MCP
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8080
# Stateless Streamable HTTP (default): each request is self-contained.
# Required for Perplexity — discovers tools then invokes without a sticky session.
MCP_STATELESS_HTTP=true
# application/json-only Accept (common for connector tool calls) requires this.
MCP_JSON_RESPONSE=true
# Static Bearer only — do not advertise a fake OAuth authorization server.
MCP_ADVERTISE_OAUTH_RESOURCE=false
# Optional idle reap for stateful sessions (seconds). Only used if STATELESS=false.
# MCP_SESSION_IDLE_TIMEOUT_SECONDS=

# Bearer token for /api/v1/* and /mcp (installer runs scripts/generate_api_secret.ps1)
API_SECRET_KEY=

# Garmin — run scripts/garmin_auth.py after install; never store email/password here
GARMIN_TOKEN_PATH=~/.garminconnect
GARMIN_MCP_ENABLED=true
GARMIN_SYNC_DAYS=30
# Alert when Garmin rejects the saved login. The message never contains the
# Garmin password. The link opens the sign-in page on PUBLIC_BASE_URL, which
# runs on this computer. ntfy is the default free service. Use a comma to
# send through more than one: ntfy,email
# none disables alerts. Leave the provider empty to use ntfy when a topic is set.
GARMIN_ALERT_PROVIDER=ntfy
# ntfy.sh topic name. Install the ntfy app and subscribe to this topic.
GARMIN_ALERT_NTFY_TOPIC=
# Optional ntfy access token (tk_...). When set, ntfy also emails the alert
# to the verified address on that account. Never commit the real value.
GARMIN_ALERT_NTFY_TOKEN=
# Blank uses https://ntfy.sh. Set this for a self-hosted ntfy server.
GARMIN_ALERT_NTFY_SERVER=
# Email alerts. The SMTP password is the mailbox password, not the Garmin password.
GARMIN_ALERT_EMAIL_TO=
GARMIN_ALERT_SMTP_HOST=
GARMIN_ALERT_SMTP_PORT=587
GARMIN_ALERT_SMTP_USER=
GARMIN_ALERT_SMTP_PASSWORD=
GARMIN_ALERT_SMTP_FROM=
# Webhook for an SMS provider or any other HTTPS alert API.
# Default body is JSON: {"title","message","link"}. A custom body may use
# {message} and {link}. {password} is not a placeholder and is never filled in.
GARMIN_ALERT_WEBHOOK_URL=
GARMIN_ALERT_WEBHOOK_HEADER=
GARMIN_ALERT_WEBHOOK_BODY=
GARMIN_ALERT_WEBHOOK_CONTENT_TYPE=

# Samsung Health — Android companion uploads batches to /api/v1/sync/samsung/import
SAMSUNG_HEALTH_IMPORT_DIR=~/.endurance-coach/samsung_health_import
SAMSUNG_HEALTH_SYNC_DAYS=365

# Public URL (https://your-host.example.com or http://127.0.0.1:8000 for local-only)
PUBLIC_BASE_URL=
DEFAULT_USER_EMAIL=
APP_TIMEZONE=America/Denver

# Built-in coach narration is optional. Leave the keys empty when your own
# MCP client is the assistant. COACH_LLM_PROVIDER is openai, anthropic,
# ollama, or openai_compatible. openai_compatible is any server with
# POST /v1/chat/completions (LM Studio, llama.cpp, vLLM, OpenRouter, and others).
COACH_LLM_PROVIDER=openai
COACH_LLM_MODEL=gpt-4o-mini
COACH_LLM_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Extra browser origins for an MCP client that is not already allowed.
# Comma-separated, for example https://chatgpt.com
MCP_ALLOWED_ORIGINS=

# Optional reverse proxy (set by installer if Caddy is enabled)
CADDY_ROOT=
CADDYFILE_PATH=
