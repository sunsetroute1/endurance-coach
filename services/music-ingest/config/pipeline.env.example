# Music ingestion pipeline paths (E:\Music is the media root).
INCOMING_DIR=E:\Music\Incoming\Soulseek
LIBRARY_DIR=E:\Music\Library
QUARANTINE_DIR=E:\Music\Quarantine
STATE_DIR=E:\Music\State
BEETS_CONFIG=%APPDATA%\beets\config.yaml

# Watcher tuning
STABILITY_SECONDS=120
POLL_INTERVAL_SECONDS=30
MIN_AUDIO_FILES=1

# Logging
LOG_DIR=
LOG_FILE=music-ingest.log
